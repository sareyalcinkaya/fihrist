# ── Fihrist Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Email (for form notifications + auto-replies) ──────────
# Recommended: use a Gmail account with an App Password.
# Go to: Google Account → Security → 2FA → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=hello@fihrist.ai
EMAIL_PASS=your_app_password_here

# Where founder notifications are sent (usually same as EMAIL_USER)
NOTIFY_TO=hello@fihrist.ai

# ── Admin endpoint secret ──────────────────────────────────
# Visit /api/admin/submissions?secret=THIS_VALUE to see all submissions
ADMIN_SECRET=change_this_to_a_long_random_string

# ── Server ────────────────────────────────────────────────
PORT=3000
